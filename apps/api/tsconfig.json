{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "target": "ES2022",
    "outDir": "./dist",
    "sourceMap": true,

    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "declaration": true,
    "removeComments": true,
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,

    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "prisma"]
}