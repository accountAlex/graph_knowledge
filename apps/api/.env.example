PORT=3001

# Neon PostgreSQL (pooled connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require&pgbouncer=true

# Neo4j on Railway (bolt via TCP proxy)
# Internal (same Railway project): neo4j://neo4j.railway.internal:7687
# External TCP proxy: bolt://zephyr.proxy.rlwy.net:34350
NEO4J_URI=bolt://zephyr.proxy.rlwy.net:34350
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Upstash Redis
REDIS_URL=rediss://default:your-token@your-host.upstash.io:6379

# JWT (generate strong secrets for prod)
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-app.vercel.app

# Mistral AI (for E9 auto-links)
MISTRAL_API_KEY=your-mistral-key

# Optional: LLM for graph/content generation (OpenRouter)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
